<script>
  import { Card } from './Card.vela';

  let items = $state.deep([{ id: 1, title: 'One' }]);
  let open = $state(false);
  let count = $derived(items.length);

  function close(event) {
    open = false;
  }
</script>

<template>
  <main>
    {#each items as item, i (item.id)}
      <Card :title={item.title} bind:value={open} @on:close={close} />
    {/each}
    <p>{count}</p>
  </main>
</template>
