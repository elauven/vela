<script lang="ts">
  import { apply, type Format } from './format.ts';

  type Kind = 'primary' | 'plain';

  interface $$Events {
    press: { at: number };
  }

  export let label: string;
  export let kind: Kind = 'plain';
  export let format: Format | null = null;
  export let pressed: boolean = $bindable(false);

  function press() {
    pressed = !pressed;
    $$dispatch('press', { at: Date.now() });
  }
</script>

<template>
  <button :class={kind} @click={press}>{apply(label, format)}<slot /></button>
</template>
