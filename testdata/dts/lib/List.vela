<script lang="ts" generics="T extends { id: string }">
  interface $$Events {
    select: { item: T };
  }
  interface $$Slots {
    empty: {};
  }

  export let items: T[];
  export let selected: T | null = null;

  function choose(item: T) {
    selected = item;
    $$dispatch('select', { item });
  }
</script>

<template>
  {#each items as item (item.id)}
    <button @click={() => choose(item)}>{item.id}</button>
  {:else}
    <slot name="empty" />
  {/each}
</template>
