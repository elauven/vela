<script lang="ts">
  import { pad2 } from 'tiny-fmt';
  import { Badge } from './widgets/Badge.vela';
  import { clicks, type Clicks } from './store.ts';

  let count = $state<number>(7);
  const store: Clicks = clicks;

  function increment(): void {
    count++;
    store.update((n: number): number => n + 1);
  }
</script>

<template>
  <button class="inc" @click={increment}>{pad2(count as number)}</button>
  <Badge :label={`b${count}` satisfies string} />
</template>

<style>
  .inc { color: rgb(1, 2, 3); }
</style>
