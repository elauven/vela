<script>
  let count = $state(0);
  let step = $state(1);
  let doubled = $derived(count * 2);
  let visible = $state(false);

  $effect(() => {
    document.title = `Count: ${count}`;
  });

  function increment() {
    count += step;
  }
  function decrement() {
    count -= step;
  }
  function reset() {
    count = 0;
  }
</script>

<template>
  <div class="counter">
    <div class="value">{count}</div>
    <div class="derived">× 2 = {doubled}</div>

    <div class="controls">
      <button class="btn-dec" @click="decrement">−</button>
      <button class="btn-rst" @click="reset">0</button>
      <button class="btn-inc" @click="increment">+</button>
    </div>

    {#if visible}<div class="step-row">
      <label>Step:</label>
      <input
        type="number"
        :value="step"
        @input="($e) => step = Number($e.target.value)"
      />
    </div>{/if}

    <div class="step-row">
      <label>Visible:</label>
      <input
        type="checkbox"
        :checked="visible"
        @change="($e) => visible = $e.target.checked"
      />
    </div>
  </div>
</template>

<style>
  .counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    font-family: system-ui, sans-serif;
  }

  .value {
    font-size: 4rem;
    font-weight: 700;
    color: #1a1a2e;
    line-height: 1;
  }

  .derived {
    font-size: 1rem;
    color: #888;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  button {
    padding: 0.5rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 1.25rem;
    cursor: pointer;
    transition: transform 0.1s;
  }

  button:active {
    transform: scale(0.95);
  }

  .btn-inc {
    background: #4ade80;
    color: #14532d;
  }
  .btn-dec {
    background: #f87171;
    color: #7f1d1d;
  }
  .btn-rst {
    background: #e5e7eb;
    color: #374151;
  }

  .step-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #555;
  }

  input[type="number"] {
    width: 4rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    text-align: center;
    font-size: 1rem;
  }
</style>
