<script>
  let newText   = $state('');
  let filter    = $state('all');   // 'all' | 'active' | 'done'
  let nextId    = $state(1);
  let todos     = $state([]);

  let remaining = $derived(todos.filter(t => !t.done).length);
  let visible   = $derived(
    filter === 'all'    ? todos :
    filter === 'active' ? todos.filter(t => !t.done) :
                          todos.filter(t =>  t.done)
  );

  function addTodo() {
    const text = newText.trim();
    if (!text) return;
    todos = [...todos, { id: nextId, text, done: false }];
    nextId++;
    newText = '';
  }

  function toggle(id) {
    todos = todos.map(t => t.id === id ? { ...t, done: !t.done } : t);
  }

  function remove(id) {
    todos = todos.filter(t => t.id !== id);
  }

  function clearDone() {
    todos = todos.filter(t => !t.done);
  }

  function handleKey($event) {
    if ($event.key === 'Enter') addTodo();
  }

  function setFilter(f) {
    filter = f;
  }
</script>

<style>
  .app {
    max-width: 480px;
    margin: 2rem auto;
    font-family: system-ui, sans-serif;
    color: #1f2937;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    text-align: center;
    color: #7c3aed;
    margin-bottom: 1.5rem;
  }

  .add-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .add-row input {
    flex: 1;
    padding: 0.6rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .add-row input:focus {
    border-color: #7c3aed;
  }

  .add-row button {
    padding: 0.6rem 1.25rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    cursor: pointer;
  }

  .filters {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .filters button {
    padding: 0.3rem 0.85rem;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: white;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.15s;
  }

  .filters button.active-filter {
    background: #7c3aed;
    color: white;
    border-color: #7c3aed;
  }

  .todo-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f3f4f6;
  }

  li input[type="checkbox"] {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: #7c3aed;
    cursor: pointer;
    flex-shrink: 0;
  }

  .todo-text {
    flex: 1;
    font-size: 1rem;
  }

  .remove-btn {
    background: none;
    border: none;
    color: #d1d5db;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    transition: color 0.15s;
  }

  .remove-btn:hover { color: #ef4444; }

  .empty {
    text-align: center;
    padding: 2rem;
    color: #9ca3af;
    font-style: italic;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .clear-btn {
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    text-decoration: underline;
    font-size: 0.875rem;
  }

  .clear-btn:hover { color: #ef4444; }
</style>

<template>
  <div class="app">
    <h1>todos</h1>

    <div class="add-row">
      <input
        type="text"
        :value="newText"
        placeholder="What needs to be done?"
        @input="($e) => newText = $e.target.value"
        @keydown="handleKey"
      />
      <button @click="addTodo">Add</button>
    </div>

    <div class="filters">
      <button @click="() => setFilter('all')">All</button>
      <button @click="() => setFilter('active')">Active</button>
      <button @click="() => setFilter('done')">Done</button>
    </div>

    <ul class="todo-list">
      {#each visible as todo, i (todo.id)}<li>
        <input type="checkbox" @change="() => toggle(todo.id)" />
        <span class="todo-text">{todo.text}</span>
        <button class="remove-btn" @click="() => remove(todo.id)">✕</button>
      </li>{/each}
    </ul>

    {#if todos.length === 0}<div class="empty">
      Nothing to do — enjoy the day ☀️
    </div>{/if}

    {#if todos.length > 0}<div class="footer">
      <span>{remaining} item{remaining === 1 ? '' : 's'} left</span>
      <button class="clear-btn" @click="clearDone">Clear done</button>
    </div>{/if}
  </div>
</template>
