            {#if subtitle}
              <div class="card-subtitle">{subtitle}</div>
              {/if}
            </div>
            <div class="header-actions">
              <slot name="actions" />
            </div>
          </div>
        {/if}

        <div class="card-body" :class="noPad ? 'no-pad' : ''">
