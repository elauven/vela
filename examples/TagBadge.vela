<script>
  export let tag   = 'tag';
  export let color = 'purple';  // 'purple' | 'green' | 'blue' | 'amber' | 'red'
  export let removable = false;

  // Map color name → CSS custom-property pair
  let bgVar  = $derived(`var(--tag-${color}-bg)`);
  let txtVar = $derived(`var(--tag-${color}-text)`);

  function remove() {
    $$dispatch('remove', { tag });
  }
</script>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }

  .remove-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-size: 0.65rem;
    line-height: 1;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .remove-btn:hover { opacity: 1; }
</style>

<template>
  <span class="tag" :style="`background:${bgVar};color:${txtVar};`">
    {tag}
    {#if removable}<button class="remove-btn" @click="remove">✕</button>{/if}
  </span>
</template>
