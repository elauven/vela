{
  "name": "@govela/unplugin",
  "version": "0.4.5",
  "description": "Vela components in Vite, Rollup, Rolldown, esbuild, webpack and Rspack. Manifest generated by the compiler repository; do not edit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elauven/vela.git",
    "directory": "packages/unplugin"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./esbuild": {
      "types": "./esbuild.d.ts",
      "default": "./esbuild.js"
    },
    "./package.json": "./package.json",
    "./rolldown": {
      "types": "./rolldown.d.ts",
      "default": "./rolldown.js"
    },
    "./rollup": {
      "types": "./rollup.d.ts",
      "default": "./rollup.js"
    },
    "./rspack": {
      "types": "./rspack.d.ts",
      "default": "./rspack.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./webpack": {
      "types": "./webpack.d.ts",
      "default": "./webpack.js"
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "vite.js",
    "vite.d.ts",
    "rollup.js",
    "rollup.d.ts",
    "rolldown.js",
    "rolldown.d.ts",
    "esbuild.js",
    "esbuild.d.ts",
    "webpack.js",
    "webpack.d.ts",
    "rspack.js",
    "rspack.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@govela/compiler": "0.4.5",
    "unplugin": "^3.4.0"
  },
  "peerDependencies": {
    "@govela/runtime": "0.4.5"
  }
}
