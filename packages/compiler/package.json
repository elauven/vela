{
  "name": "@govela/compiler",
  "version": "0.4.2",
  "description": "The Vela compiler: single-file components to ES modules, and Go server renderers. Manifest generated by the compiler repository; do not edit.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vela": "bin/vela.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "index.d.ts",
  "files": [
    "bin/vela.js",
    "index.js",
    "index.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@govela/compiler-darwin-arm64": "0.4.2",
    "@govela/compiler-darwin-x64": "0.4.2",
    "@govela/compiler-linux-arm64": "0.4.2",
    "@govela/compiler-linux-x64": "0.4.2",
    "@govela/compiler-win32-x64": "0.4.2"
  }
}
