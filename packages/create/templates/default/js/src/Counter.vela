<script>
  export let step = 1;

  let count = $state(0);

  function increment() {
    count += step;
    $$dispatch('change', count);
  }
</script>

<template>
  <button @click={increment}>
    <slot>Count</slot>: {count}
  </button>
</template>

<style>
  button {
    font: inherit;
    padding: 0.5rem 1rem;
  }
</style>
