      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./match": {
      "types": "./match.d.ts",
      "default": "./match.js"
    }
  },
  "files": [
    "client.js",
    "client.d.ts",
    "match.js",
    "match.d.ts",
    "LICENSE"
  ],
  "govela": {
    "runtimeContract": 4,
    "protocol": 1
  },
  "peerDependencies": {
    "@govela/runtime": ">=0.4.7"
  }
