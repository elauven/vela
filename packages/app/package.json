{
  "name": "@govela/app",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Client router of Vela App (docs/APP.md): hydration, data navigation and route matching.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elauven/vela.git",
    "directory": "packages/app"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
