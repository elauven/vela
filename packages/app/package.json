{
  "name": "@govela/app",
  "version": "0.4.0",
  "description": "Vela App (docs/APP.md): the client router (hydration, data navigation, route matching) and the vela-app command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elauven/vela.git",
    "directory": "packages/app"
  },
  "type": "module",
  "bin": {
    "vela-app": "bin/vela-app.js"
  },
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./match": {
      "types": "./match.d.ts",
      "default": "./match.js"
    }
  },
  "files": [
    "bin/vela-app.js",
    "client.js",
    "client.d.ts",
    "match.js",
    "match.d.ts",
    "LICENSE"
  ],
  "govela": {
    "runtimeContract": 6,
    "protocol": 1
  },
  "peerDependencies": {
    "@govela/runtime": ">=0.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@govela/app-darwin-arm64": "0.4.0",
    "@govela/app-darwin-x64": "0.4.0",
    "@govela/app-linux-arm64": "0.4.0",
    "@govela/app-linux-x64": "0.4.0",
    "@govela/app-win32-x64": "0.4.0"
  }
}
