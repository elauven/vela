{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    [
      "<!--",
      "-->"
    ],
    [
      "<",
      ">"
    ],
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "<!--",
      "close": "-->",
      "notIn": [
        "comment",
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "'",
      "'"
    ],
    [
      "\"",
      "\""
    ],
    [
      "`",
      "`"
    ],
    [
      "<",
      ">"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(<!--\\s*#region\\b.*-->|\\{#(if|each|await|key|client)\\b|<(script|style|template)\\b)",
      "end": "^\\s*(<!--\\s*#endregion\\b.*-->|\\{/(if|each|await|key|client)\\}|</(script|style|template)>)"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@#%^&*()\\-=+\\[{\\]}\\\\|;:'\\\",.<>/?\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(<(?!(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)\\b)[a-zA-Z][^/>]*(?<!/)>(?!.*</)|\\{[#:](if|each|await|key|client|else|then|catch)\\b[^}]*\\})\\s*$",
    "decreaseIndentPattern": "^\\s*(</[^>]+>|\\{[/:](if|each|await|key|client|else|then|catch)\\b[^}]*\\})"
  }
}
