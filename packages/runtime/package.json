{
  "name": "@govela/runtime",
  "version": "0.10.0",
  "description": "Runtime of components compiled by the Vela compiler. Generated from runtime/; do not edit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elauven/vela.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "sideEffects": [
    "./runtime.js"
  ],
  "exports": {
    ".": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    },
    "./ambient": {
      "types": "./ambient.d.ts"
    },
    "./blocks": "./runtime-blocks.js",
    "./hydrate": {
      "types": "./runtime-hydrate.d.ts",
      "default": "./runtime-hydrate.js"
    }
  },
  "types": "runtime.d.ts",
  "files": [
    "runtime.js",
    "runtime.d.ts",
    "runtime-blocks.js",
    "runtime-hydrate.js",
    "runtime-hydrate.d.ts",
    "ambient.d.ts",
    "LICENSE"
  ]
}
