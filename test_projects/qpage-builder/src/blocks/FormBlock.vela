<script>
  export let p = {};

  let name = $state('');
  let phone = $state('');
  let email = $state('');
  let sent = $state(false);

  function submit(e) {
    e.preventDefault();
    sent = true;
  }
</script>
<template>
  <section class="formsec" id="form">
    <div class="wrap">
      <h2>{p.title}</h2>
      {#if p.subtitle}<p class="sub">{p.subtitle}</p>{/if}

      {#if sent}
        <div class="ok">✓ Заявка отправлена. Мы свяжемся с вами!</div>
      {:else}
        <form class="lead" @submit={submit}>
          {#if p.showName !== false}
            <input required placeholder="Имя" value={name} @input={(e) => name = e.target.value} />
          {/if}
          {#if p.showPhone !== false}
            <input required type="tel" placeholder="Телефон" value={phone} @input={(e) => phone = e.target.value} />
          {/if}
          {#if p.showEmail}
            <input type="email" placeholder="Email" value={email} @input={(e) => email = e.target.value} />
          {/if}
          <button class="btn" type="submit">{p.btn || 'Отправить'}</button>
        </form>
        {#if p.note}<p class="note">{p.note}</p>{/if}
      {/if}
    </div>
  </section>
</template>
<style>
  .formsec { padding: 56px 0; background: #f5f7fb; font-family: system-ui, sans-serif; }
  .wrap { max-width: 780px; margin: 0 auto; padding: 0 20px; }
  h2 { font-size: 32px; text-align: center; margin: 0 0 10px; color: #17203a; }
  .sub { text-align: center; color: #5b6b85; margin: 0 0 26px; }
  .lead { display: grid; gap: 12px; max-width: 460px; margin: 0 auto; }
  .lead input { padding: 13px 14px; border: 1px solid #d7deea; border-radius: 10px;
                font-size: 15px; font: inherit; background: #fff; }
  .btn { background: #2563eb; color: #fff; border: 0; padding: 13px; border-radius: 10px;
         font-weight: 600; font-size: 15px; cursor: pointer; font: inherit; font-weight: 600; }
  .ok { background: #e8f7ee; color: #1d7a3e; border: 1px solid #bfe6cd; border-radius: 10px;
        padding: 14px 16px; max-width: 460px; margin: 0 auto; font-weight: 600; }
  .note { text-align: center; color: #8a94a8; font-size: 12.5px; margin-top: 14px; }
</style>
