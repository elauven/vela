<script>
  export let p = {};

  let email = $state('');
  let done = $state(false);

  function subscribe(e) {
    e.preventDefault();
    if (email) done = true;
  }
</script>
<template>
  <footer class="ftr">
    <div class="row">
      <div class="col"><h4>О нас</h4><p>{p.about}</p></div>
      <div class="col">
        <h4>Разделы</h4>
        {#each p.links || [] as l}<a href={l.href || '#'}>{l.label}</a>{/each}
      </div>
      <div class="col">
        <h4>Контакты</h4>
        {#if p.phone}<a href={'tel:' + p.phone}>{p.phone}</a>{/if}
        {#if p.email}<a href={'mailto:' + p.email}>{p.email}</a>{/if}
        <a class="privacy" href="#">{p.privacy}</a>
      </div>
      {#if p.subscribe}
        <div class="col">
          <h4>{p.subscribeTitle || 'Подписка'}</h4>
          {#if done}
            <p class="ok">Спасибо! Вы подписаны.</p>
          {:else}
            <form class="sub" @submit={subscribe}>
              <input type="email" required placeholder="Ваш email"
                value={email} @input={(e) => email = e.target.value} />
                <button type="submit">Ок</button>
              </form>
            {/if}
          </div>
        {/if}
      </div>
      <div class="bottom">{p.copyright}</div>
    </footer>
</template>
<style>
  .ftr { background: #14181f; color: #cfd6e4; font-family: system-ui, sans-serif; }
  .row { max-width: 1100px; margin: 0 auto; padding: 48px 20px 36px; display: grid;
         grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 28px; }
  h4 { color: #fff; margin: 0 0 12px; }
  p { margin: 0; font-size: 14px; }
  .col a { color: #cfd6e4; text-decoration: none; display: block; margin-bottom: 8px; font-size: 14px; }
  .col a:hover { color: #fff; }
  .privacy { font-size: 12.5px; color: #8a94a8; }
  .sub { display: flex; gap: 8px; }
  .sub input { flex: 1; background: #0f1219; border: 1px solid #2a3140; border-radius: 8px;
               color: #fff; padding: 9px 12px; font: inherit; min-width: 0; }
  .sub button { background: #2563eb; border: 0; color: #fff; border-radius: 8px;
                padding: 9px 14px; cursor: pointer; }
  .ok { color: #7ddba0; font-weight: 600; }
  .bottom { border-top: 1px solid #232a38; padding: 16px 20px; text-align: center;
            color: #8a94a8; font-size: 13px; }
</style>
