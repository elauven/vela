<script>
  import { $$dispatch } from 'vela';

  export let todo;

  let editing = $state(false);
  let draft = $state('');

  function toggle() {
    $$dispatch('toggle');
  }

  function remove() {
    $$dispatch('remove');
  }

  function startEdit() {
    draft = todo.title;
    editing = true;
  }

  function saveEdit() {
    if (!editing) return;
    editing = false;
    const title = draft.trim();
    if (title && title !== todo.title) {
      $$dispatch('rename', { title });
    }
  }

  function cancelEdit() {
    editing = false;
  }

  function handleEditKeydown(event) {
    if (event.key === 'Enter') {
      saveEdit();
    } else if (event.key === 'Escape') {
      cancelEdit();
    }
  }
</script>
<template>
  <li class="todo-item" :class:done={todo.done}>
    {#if editing}
      <input
        class="edit-input"
        bind:value={draft}
        @keydown={handleEditKeydown}
        @blur={saveEdit}
        />
      {:else}
        <label class="todo-label">
          <input
            type="checkbox"
            class="toggle-checkbox"
            :checked={todo.done}
            @change={toggle}
            />
            <span class="todo-title" @dblclick={startEdit}>{todo.title}</span>
          </label>
          <button class="remove-button" aria-label="Удалить задачу" @click={remove}>
            ×
          </button>
        {/if}
      </li>
</template>
<style>
  .todo-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #e2e6ee;
    border-radius: 0.5rem;
    background: #fff;
  }

  .todo-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    cursor: pointer;
  }

  .todo-title {
    word-break: break-word;
  }

  .done .todo-title {
    text-decoration: line-through;
    color: #8a93a6;
  }

  .edit-input {
    flex: 1;
    padding: 0.375rem 0.5rem;
    border: 1px solid #7aa2ff;
    border-radius: 0.375rem;
    font: inherit;
  }

  .remove-button {
    border: none;
    background: transparent;
    color: #c0392b;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }
</style>
  }
</style>
