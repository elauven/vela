<script>
  import { TodoItem } from './TodoItem.vela';

  const STORAGE_KEY = 'vela-todos';

  function loadStoredTodos() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { todos: [], nextId: 1 };
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed.todos)) return { todos: [], nextId: 1 };
      const nextId = typeof parsed.nextId === 'number'
        ? parsed.nextId
        : parsed.todos.length + 1;
      return { todos: parsed.todos, nextId };
    } catch {
      return { todos: [], nextId: 1 };
    }
  }

  const stored = loadStoredTodos();

  let todos = $state(stored.todos);
  let nextId = stored.nextId;
  let newTitle = $state('');
  let filter = $state('all');

  let remaining = $derived(todos.filter((todo) => !todo.done).length);
  let completedCount = $derived(todos.length - remaining);

  let visibleTodos = $derived(
    filter === 'active'
      ? todos.filter((todo) => !todo.done)
      : filter === 'done'
        ? todos.filter((todo) => todo.done)
        : todos
  );

  $effect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ todos, nextId }));
    } catch {
      // хранилище недоступно — просто не сохраняем
    }
  });

  function addTodo(event) {
    event.preventDefault();
    const title = newTitle.trim();
    if (!title) return;
    todos = [...todos, { id: nextId++, title, done: false }];
    newTitle = '';
  }

  function toggleTodo(id) {
    todos = todos.map((todo) =>
      todo.id === id ? { ...todo, done: !todo.done } : todo
    );
  }

  function removeTodo(id) {
    todos = todos.filter((todo) => todo.id !== id);
  }

  function renameTodo(id, title) {
    todos = todos.map((todo) =>
      todo.id === id ? { ...todo, title } : todo
    );
  }

  function clearCompleted() {
    todos = todos.filter((todo) => !todo.done);
  }
</script>
<template>
  <main class="todo-app">
    <h1 class="app-title">Список задач</h1>

    <form class="add-form" @submit={addTodo}>
      <input
        class="new-title-input"
        placeholder="Что нужно сделать?"
        bind:value={newTitle}
        />
        <button class="add-button" type="submit" :disabled={newTitle.trim() === ''}>
          Добавить
        </button>
      </form>

      <div class="toolbar">
        <div class="filters">
          <button
            class="filter-button"
            class:selected={filter === 'all'}
            @click={() => (filter = 'all')}
            >
            Все
          </button>
          <button
            class="filter-button"
            class:selected={filter === 'active'}
            @click={() => (filter = 'active')}
            >
            Активные
          </button>
          <button
            class="filter-button"
            class:selected={filter === 'done'}
            @click={() => (filter = 'done')}
            >
            Выполненные
          </button>
        </div>

        {#if completedCount > 0}
          <button class="clear-button" @click={clearCompleted}>
            Очистить выполненные
          </button>
        {/if}
      </div>

      <ul class="todo-list">
        {#each visibleTodos as todo (todo.id)}
          <TodoItem
            :todo={todo}
            @on:toggle={() => toggleTodo(todo.id)}
            @on:remove={() => removeTodo(todo.id)}
            @on:rename={(event) => renameTodo(todo.id, event.detail.title)}
            />
          {:else}
            <li class="empty">
              {#if filter === 'active'}
                Нет активных задач.
              {:else if filter === 'done'}
                Нет выполненных задач.
              {:else}
                Задач пока нет — добавьте первую.
              {/if}
            </li>
          {/each}
        </ul>

        <p class="counter">Осталось: {remaining} из {todos.length}</p>
        <p class="hint">Двойной клик по названию задачи — переименование.</p>
      </main>
</template>
<style>
  .todo-app {
    max-width: 30rem;
    margin: 2rem auto;
    padding: 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
    color: #1f2430;
  }

  .app-title {
    margin: 0 0 1rem;
    font-size: 1.5rem;
  }

  .add-form {
    display: flex;
    gap: 0.5rem;
  }

  .new-title-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid #cbd2e0;
    border-radius: 0.5rem;
    font: inherit;
  }

  .add-button {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    background: #345cff;
    color: #fff;
    cursor: pointer;
  }

  .add-button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  .filters {
    display: flex;
    gap: 0.25rem;
  }

  .filter-button {
    padding: 0.25rem 0.75rem;
    border: 1px solid #cbd2e0;
    border-radius: 999px;
    background: #fff;
    cursor: pointer;
  }

  .filter-button.selected {
    background: #345cff;
    border-color: #345cff;
    color: #fff;
  }

  .clear-button {
    border: none;
    background: transparent;
    color: #c0392b;
    cursor: pointer;
  }

  .todo-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    padding: 1rem;
    text-align: center;
    color: #8a93a6;
    border: 1px dashed #cbd2e0;
    border-radius: 0.5rem;
  }

  .counter {
    margin-top: 1rem;
    color: #5a6375;
    font-size: 0.875rem;
  }

  .hint {
    color: #8a93a6;
    font-size: 0.75rem;
  }
</style>
