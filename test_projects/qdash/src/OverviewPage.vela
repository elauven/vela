<script>
  import { fetchOverview, fetchPosts } from './api.js';

  let overviewPromise = $state(fetchOverview());
  let postsPromise = $state(fetchPosts(5));

  function refresh() {
    overviewPromise = fetchOverview();
    postsPromise = fetchPosts(5);
  }
</script>
<template>
  <section class="page">
    <header class="page-header">
      <h2>Обзор</h2>
      <button class="button secondary" @click={refresh}>Обновить</button>
    </header>

    {#await overviewPromise}
      <p class="loading">Загружаем статистику…</p>
    {:then stats}
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-value">{stats.users}</span>
          <span class="stat-label">Пользователи</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{stats.posts}</span>
          <span class="stat-label">Записи</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{stats.todosCompleted} / {stats.todosTotal}</span>
          <span class="stat-label">Задачи выполнены</span>
        </div>
      </div>
    {:catch error}
      <p class="error">{error.message}</p>
    {/await}

    <h3 class="section-title">Последние записи</h3>

    {#await postsPromise}
      <p class="loading">Загружаем записи…</p>
    {:then posts}
      <ul class="post-list">
        {#each posts as post (post.id)}
          <li class="post-item">{post.title}</li>
        {:else}
          <li class="empty">Записей нет.</li>
        {/each}
      </ul>
    {:catch error}
      <p class="error">{error.message}</p>
    {/await}
  </section>
</template>
<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e2e6ee;
    border-radius: 0.75rem;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .stat-label {
    color: #5a6375;
    font-size: 0.875rem;
  }

  .section-title {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-item {
    padding: 0.625rem 0.75rem;
    background: #fff;
    border: 1px solid #e2e6ee;
    border-radius: 0.5rem;
    text-transform: capitalize;
  }

  .empty {
    padding: 0.75rem;
    color: #8a93a6;
    border: 1px dashed #cbd2e0;
    border-radius: 0.5rem;
    text-align: center;
  }
</style>
